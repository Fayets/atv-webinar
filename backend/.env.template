# --- Base de datos ---
# Local: sqlite. VPS: postgres (Neon del ecosistema, esquema propio).
DB_PROVIDER=sqlite
DB_FILENAME=database.sqlite

# Solo con DB_PROVIDER=postgres
DB_SCHEMA=webinar
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# --- Acceso al dashboard ---
# Con SECRET (el mismo de atv-ecosystem) se valida la cookie ecosystem_session.
# Sin SECRET se cae al PIN, para desarrollo local.
SECRET=
DASHBOARD_PIN=

# --- Meta (pixel + Conversions API) ---
# El id del pixel también va hardcodeado en frontend/index.html (es público).
META_PIXEL_ID=
META_CAPI_TOKEN=
# Opcional: código de prueba de Events Manager para validar sin ensuciar datos.
META_TEST_EVENT_CODE=

# --- Contenido ---
FRONTEND_ORIGIN=http://localhost:5174
VSL_URL=
VSL_VIMEO_ID=
WHATSAPP_GROUP_URL=
WEBINAR_TITLE=
WEBINAR_STARTS_AT=
WEBINAR_DURATION_MIN=90
WEBINAR_DETAILS=
WEBINAR_URL=
